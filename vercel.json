{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "sh scripts/build-portal-public.sh",
  "installCommand": "",
  "outputDirectory": "portal-public",
  "functions": {
    "api/partner-content.py": {
      "includeFiles": "dist/**"
    },
    "api/partner-media.js": {
      "includeFiles": "dist/data.js",
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "^/(?:index\\.html)?$",
      "dest": "/api/partner-content?file=index.html"
    },
    {
      "src": "^/(app\\.js|data\\.js|guide\\.js)$",
      "dest": "/api/partner-content?file=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(assets/[A-Za-z0-9_./-]+)$",
      "dest": "/api/partner-content?file=$1"
    }
  ]
}
